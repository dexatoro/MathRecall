{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "MathRecall.CardExchange"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "cards": {
      "minItems": 1,
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "definition",
              "proof",
              "problem"
            ]
          },
          "subject": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "topicPath": {
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "tickets": {
            "maxItems": 30,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "description": {
                  "type": "string",
                  "maxLength": 20000
                }
              },
              "required": [
                "name",
                "description"
              ],
              "additionalProperties": false
            }
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "answer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "hints": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20000
            }
          },
          "sources": {
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "url": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 1000,
                      "pattern": "^https?:\\/\\/"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "pageStart": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 100000
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "pageEnd": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 100000
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "title",
                "url",
                "pageStart",
                "pageEnd"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "type",
          "subject",
          "topicPath",
          "tickets",
          "question",
          "answer",
          "hints",
          "sources"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "format",
    "version",
    "cards"
  ],
  "additionalProperties": false,
  "$id": "urn:mathrecall:card-exchange:1",
  "title": "MathRecall Card Exchange v1",
  "description": "Обмен учебными карточками, не резервная копия. Не содержит UUID, FSRS и историю. Дополнительные проверки Zod: pageEnd >= pageStart, билеты требуют topicPath, итоговое поле источников <= 2000 символов."
}
